# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/trash_detection"

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="EcoPoint <your_email@gmail.com>"

# OTP
OTP_EXPIRES_MINUTES=5
